{
  "name": "pulse-analytics-backend",
  "version": "1.0.0",
  "description": "Backend API and worker pipeline for Pulse Analytics event tracking and reporting.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "docker compose up -d && concurrently --names \"api,worker\" --prefix-colors \"cyan,yellow\" \"tsx watch src/index.ts\" \"tsx src/worker.ts\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx src/worker.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "start": "node --import tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx db/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "load:seed": "node tests/load/seed-load-test.mjs",
    "load:auth": ". ./tests/load/load-test.env && artillery run tests/load/auth.yml --output tests/load/reports/auth.json",
    "load:ingestion": ". ./tests/load/load-test.env && artillery run tests/load/ingestion.yml --output tests/load/reports/ingestion.json",
    "load:analytics": ". ./tests/load/load-test.env && artillery run tests/load/analytics.yml --output tests/load/reports/analytics.json"
  },
  "keywords": [
    "pulse-analytics",
    "analytics",
    "event-tracking",
    "web-analytics",
    "backend",
    "api",
    "express",
    "typescript",
    "prisma",
    "bullmq"
  ],
  "author": "akdevv",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@maxmind/geoip2-node": "^6.3.4",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.70.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.3.1",
    "ua-parser-js": "^2.0.8",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.1.5",
    "artillery": "^2.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prisma": "^7.1.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  }
}
