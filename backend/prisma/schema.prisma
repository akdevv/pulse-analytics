generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  name        String?
  email       String   @unique
  password    String?
  isVerified  Boolean  @default(false)
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sites       Site[]
  conversations Conversation[]
}

model Site {
  id            String        @id @default(uuid())
  name          String
  domain        String
  userId        String
  // Unique, not just indexed. Lookups use findFirst on the ingestion path.
  trackingId    String        @unique
  rateLimitTier RateLimitTier @default(FREE)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  events        Event[]
  conversations Conversation[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per user, not global. One account must not claim a domain for everyone.
  @@unique([userId, domain])
  @@index([userId])
  @@map("sites")
}

model Conversation {
  id        String      @id @default(uuid())
  userId    String
  siteId    String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, siteId])
  @@map("conversations")
}

// The audit log itself. Stores generated SQL, never returned rows.
model AiMessage {
  id             String       @id @default(uuid())
  conversationId String
  role           AiRole
  content        String
  sql            String?
  rowCount       Int?
  latencyMs      Int?
  error          String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiRole {
  USER
  ASSISTANT
}

model Event {
  id               String    @default(uuid())
  siteId           String
  eventId          String
  eventType        EventType
  eventName        String?
  url              String    @db.VarChar(2048)
  urlHostname      String    @db.VarChar(255)
  urlPathname      String    @db.VarChar(1024)
  urlSearch        String?   @db.VarChar(1024)
  pageTitle        String?   @db.VarChar(500)
  referrer         String?   @db.VarChar(2048)
  sessionId        String?   @db.Uuid
  visitorId        String?   @db.Uuid
  userAgent        String?   @db.VarChar(500)
  deviceType       String?   @db.VarChar(20)
  browser          String    @db.VarChar(50)
  browserVersion   String    @db.VarChar(20)
  os               String    @db.VarChar(50)
  osVersion        String    @db.VarChar(20)
  country          String?
  countryCode      String?
  city             String?
  region           String?
  eventProperties  Json?
  timestamp        DateTime
  receivedAt       DateTime  @default(now())
  screenResolution String?   @db.VarChar(15)
  userLanguage     String?   @db.VarChar(10)
  viewportSize     String?   @db.VarChar(15)
  // ponytail: cascade deletes a site's events in one statement. Fine at demo
  // volume. Drop the hypertable chunks instead if a site ever holds millions.
  site             Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([id, receivedAt])
  @@index([siteId, timestamp(sort: Desc)])
  @@index([sessionId])
  @@index([visitorId])
  @@index([urlPathname, siteId])
  @@index([eventType, siteId])
  @@map("events")
}

enum RateLimitTier {
  FREE
  PRO
  ENTERPRISE
}

enum EventType {
  PAGEVIEW
  CLICK
  CUSTOM
}
