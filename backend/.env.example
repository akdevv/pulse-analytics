PORT=8000
NODE_ENV=development

# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Timescale Cloud connection string
DATABASE_URL=postgresql://user:password@host.timescaledb.io:5432/dbname?sslmode=require
# The ai_readonly role from db/migrations/0008: same database, restricted role.
# Empty disables the AI query feature.
# Production: ALTER ROLE ai_readonly PASSWORD '...'
AI_DATABASE_URL=postgresql://ai_readonly:password@localhost:5432/pulse_dev

# Any OpenAI-compatible /chat/completions endpoint. Empty AI_API_KEY disables
# the feature; the rest of the API still boots.
# Model ids: curl $AI_BASE_URL/models -H "Authorization: Bearer $AI_API_KEY"
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b


# ElastiCache endpoint (Terraform output: redis_endpoint)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Unset follows NODE_ENV: off in development, on otherwise. Set explicitly to
# test limits locally or disable them elsewhere.
RATE_LIMIT_ENABLED=

# Path inside the container. The file is baked into the image.
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# CORS origin. In production, the Vercel URL.
FRONTEND_URL=http://localhost:3000
