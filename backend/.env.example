# Copy to .env for dev, or .env.prod on a deployed box. In production
# everything runs in docker, so hosts are service names, not localhost.

PORT=8000
NODE_ENV=development

# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Production: host "postgres", password matching POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://postgres:password@localhost:5432/pulse_dev

# The restricted role from db/migrations/0008. Empty disables the AI feature.
AI_DATABASE_URL=postgresql://ai_readonly:ai_readonly@localhost:5432/pulse_dev

# Any OpenAI-compatible /chat/completions endpoint. Empty key disables the
# feature; the rest of the API still boots.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Write the host out. An empty value is not an unset one: config/env.ts only
# applies its default when the key is absent, so "" is used verbatim.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Unset follows NODE_ENV: off in development, on otherwise.
RATE_LIMIT_ENABLED=

# Mounted into the worker from ./data, not baked into the image. Missing file
# disables geo, it does not crash.
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# CORS origin for the dashboard routes. Production: the Vercel URL.
FRONTEND_URL=http://localhost:3000

# --- read by docker compose, not the app. .env.prod only. ---
# POSTGRES_PASSWORD=
# POSTGRES_DB=pulse
# PG_BIND=127.0.0.1
# REDIS_BIND=127.0.0.1
# API_BIND=0.0.0.0
