PORT=8000
NODE_ENV=development

# JWT — generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Database — Timescale Cloud connection string
DATABASE_URL=postgresql://user:password@host.timescaledb.io:5432/dbname?sslmode=require

# Redis — ElastiCache endpoint (Terraform output: redis_endpoint)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting — disable in dev/test to avoid blocking load tests
RATE_LIMIT_ENABLED=true

# GeoIP — path inside container (file baked into Docker image)
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# CORS — set to Vercel URL in prod (e.g. https://pulse-analytics.vercel.app)
FRONTEND_URL=http://localhost:3000
