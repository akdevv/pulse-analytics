PORT=8000
NODE_ENV=development

# JWT — generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Database — Timescale Cloud connection string
DATABASE_URL=postgresql://user:password@host.timescaledb.io:5432/dbname?sslmode=require
# AI sandbox — the ai_readonly role from db/migrations/0008. Same database as
# DATABASE_URL, restricted role. Empty disables the AI query feature.
# Production: reset the role password from a secret with
#   ALTER ROLE ai_readonly PASSWORD '...';
AI_DATABASE_URL=postgresql://ai_readonly:password@localhost:5432/pulse_dev

# AI provider — any OpenAI-compatible /chat/completions endpoint.
# Groq: https://api.groq.com/openai/v1 (check ids: curl $AI_BASE_URL/models -H "Authorization: Bearer $AI_API_KEY")
# Empty AI_API_KEY disables the AI query feature; the rest of the API still boots.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b


# Redis — ElastiCache endpoint (Terraform output: redis_endpoint)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting — unset follows NODE_ENV: off in development, on otherwise.
# Set to true to test limits locally, false to disable in a non-dev environment.
RATE_LIMIT_ENABLED=

# GeoIP — path inside container (file baked into Docker image)
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# CORS — set to Vercel URL in prod (e.g. https://pulse-analytics.vercel.app)
FRONTEND_URL=http://localhost:3000
